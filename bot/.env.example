# Telegram Bot Token (from @BotFather)
TELEGRAM_BOT_TOKEN=your_bot_token_here

# MongoDB Connection String
MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/lavaquita

# Webapp URL (for Mini App buttons)
WEBAPP_URL=http://localhost:5173

# Openfort Server API (for pool wallet creation)
OPENFORT_API_KEY=sk_test_your_secret_key_here
OPENFORT_POLICY_ID=pol_your_policy_id

# USDC Contract Address (Base Sepolia testnet)
USDC_CONTRACT_ADDRESS=0x036CbD53842c5426634e7929541eC2318f3dCF7e

# Base Sepolia RPC URL
BASE_RPC_URL=https://sepolia.base.org

# Environment
NODE_ENV=development
